@{
    ViewData["Title"] = "Video Catalogue";
}

<div class="container py-4">
    <!-- Header -->
    <h1 class="text-center mb-4">Video Catalogue</h1>

    <!-- Nav -->
    <ul class="nav nav-tabs mb-3" id="viewTabs">
        <li class="nav-item">
            <a class="nav-link active" href="#" data-view="catalogue">Catalogue</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" data-view="upload">Upload</a>
        </li>
    </ul>

    <!-- Catalogue view -->
    <div id="catalogueView">
        <div id="catalogueMessage" class="alert alert-info d-none">
            No videos uploaded yet.
        </div>

        <!-- Player (hidden by default) -->
        <div id="videoPlayerContainer" class="text-center mb-4 d-none"
             style="position: relative; width: 100%; padding-top: 56.25%;">
            <video id="videoPlayer" controls
                   style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain;"></video>
        </div>

        <!-- Table -->
        <table id="videoTable" class="table table-striped d-none">
            <thead>
                <tr>
                    <th>Video Filename</th>
                    <th>File Size KB</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <!-- Upload view -->
    <div id="uploadView" class="d-none">
        <div id="uploadAlert" class="alert d-none"></div>

        <form id="uploadForm">
            <div class="mb-3">
                <input type="file" id="fileInput" name="files" multiple accept="video/mp4" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>
    </div>
</div>
<!-- Toast notification -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="uploadToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="uploadToastBody">
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/app.js"></script>
}

